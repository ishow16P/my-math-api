PORT=3001
MONGODB_URI=mongodb://localhost:27017/my-math

# Access Token (short-lived, 15m recommended)
JWT_ACCESS_SECRET=access-secret-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token (long-lived, 7d recommended)
JWT_REFRESH_SECRET=refresh-secret-change-this-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Cloudflare R2 (S3-compatible storage for canvas images)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=my-math-canvas
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173